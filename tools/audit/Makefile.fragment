# Targets for the root Makefile (merge by the lead). Recipe lines start with a tab.
# The audit reads INFORA_URL, INFORA_USERNAME and INFORA_PASSWORD from the environment only.

PLAYWRIGHT_BROWSERS_PATH ?= /opt/pw-browsers
export PLAYWRIGHT_BROWSERS_PATH

.PHONY: audit audit-check-tokens audit-test audit-test-fast audit-install

audit-install: ## Install the audit tool on its own
	pnpm --dir tools/audit install --ignore-workspace --frozen-lockfile

audit: ## Run the read-only Infora audit into ./audit (docs/01-audit.md)
	pnpm --filter @strata/audit audit

audit-check-tokens: ## Criterion 2: check that each computed value maps to a token in audit/tokens.json
	pnpm --filter @strata/audit check-tokens

audit-test: ## All audit tool tests against the local mock site
	pnpm --filter @strata/audit test

audit-test-fast: ## Unit and guard tests only
	pnpm --filter @strata/audit test:fast
