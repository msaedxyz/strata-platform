# Copy to .env with `make setup`. make setup fills every empty secret with a random value.
# Never commit .env.

# Public URLs
STRATA_PUBLIC_URL=http://localhost:8088
STRATA_OIDC_ISSUER=http://localhost:8080/realms/strata

# Database (secrets: filled by make setup)
POSTGRES_PASSWORD=
STRATA_APP_DB_PASSWORD=
STRATA_OWNER_DB_PASSWORD=

# Keycloak admin and the password of the local development users (secrets: filled by make setup)
KEYCLOAK_ADMIN_PASSWORD=
STRATA_DEV_USER_PASSWORD=

# Object storage (secrets: filled by make setup)
STRATA_S3_ACCESS_KEY=
STRATA_S3_SECRET_KEY=

# Key that wraps the key of each person entity (secret: filled by make setup)
STRATA_MASTER_KEY=

# Anthropic API key for the agents. Without it, the agents use the deterministic backend.
ANTHROPIC_API_KEY=

# Contact address in the collector User-Agent
STRATA_CONTACT_EMAIL=strata-collector@example.invalid

# Alert email
STRATA_ALERT_EMAIL_TO=alerts@strata.local

# Set to 1 to point the collectors at the local fixture server instead of the real sources
STRATA_FIXTURE_MODE=0
