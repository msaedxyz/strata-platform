{
  "name": "@strata/eslint-plugin-strata",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Lint rules for Strata. The no-raw-values rule stops raw colour and size values outside packages/design-system (docs/07 rule 6).",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./config": "./src/config.js",
    "./stylelint": "./src/stylelint.config.js",
    "./raw-values": "./src/raw-values.js"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "build": "node --check src/index.js"
  },
  "peerDependencies": {
    "eslint": "^10.0.0"
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "typescript-eslint": "^8.70.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "eslint": "^10.11.0",
    "stylelint": "^17.15.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  }
}
