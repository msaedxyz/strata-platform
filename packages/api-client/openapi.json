    "/api/sources/manual": {
      "post": {
        "description": "An analyst uploads a file (multipart: file, title, publisher, licence_code, url) or a URL (JSON).",
        "operationId": "manual_upload_api_sources_manual_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "licence_code": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "title": "Licence Code"
                  },
                  "publisher": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "title": "Publisher"
                  },
                  "title": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "title": "Title"
                  },
                  "url": {
                    "pattern": "^https?://",
                    "title": "Url",
                    "type": "string"
                  }
                },
                "required": [
                  "url"
                ],
                "title": "ManualUrl",
                "type": "object"
              }
            },
            "multipart/form-data": {
              "schema": {
                "properties": {
                  "file": {
                    "format": "binary",
                    "type": "string"
                  },
                  "licence_code": {
                    "type": "string"
                  },
                  "publisher": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  },
                  "url": {
                    "type": "string"
                  }
                },
                "required": [
                  "file"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Manual Upload Api Sources Manual Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Manual Upload",
        "tags": [
          "sources"
        ]
      }
    },
