  "motion": {
    "duration": {
      "$type": "duration",
      "fast": {
        "$value": {
          "value": 80,
          "unit": "ms"
        }
      },
      "normal": {
        "$value": {
          "value": 150,
          "unit": "ms"
        }
      },
      "slow": {
        "$value": {
          "value": 250,
          "unit": "ms"
        }
      }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": {
        "$value": [
          0.2,
          0,
          0,
          1
        ]
      },
      "emphasized": {
        "$value": [
          0.3,
          0,
          0.1,
          1
        ]
      }
    }
  }
}
