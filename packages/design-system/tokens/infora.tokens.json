          ],
          "hex": "#000000",
          "alpha": 0.6
        },
        "offsetX": {
          "value": 0,
          "unit": "px"
        },
        "offsetY": {
          "value": 12,
          "unit": "px"
        },
        "blur": {
          "value": 32,
          "unit": "px"
        },
        "spread": {
          "value": 0,
          "unit": "px"
        }
      }
    }
  },
  "z": {
    "$type": "number",
    "base": {
      "$value": 0
    },
    "panel": {
      "$value": 1
    },
    "sticky": {
      "$value": 10
    },
    "dropdown": {
      "$value": 100
    },
    "drawer": {
      "$value": 200
    },
    "modal": {
      "$value": 300
    },
    "toast": {
      "$value": 400
