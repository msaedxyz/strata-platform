{
  "$description": "Infora design tokens for Strata. Format: W3C Design Tokens Community Group (DTCG) 2025.10. Only these values may style a component.",
  "$extensions": {
    "strata": {
      "provisional": true,
      "reason": "beta.infora.io blocked by the build network policy on 2026-09-26; replace with `pnpm tokens:sync` after the audit"
    }
  },
  "color": {
    "$type": "color",
    "bg": {
      "base": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.0392,
            0.0471,
            0.0588
          ],
          "hex": "#0a0c0f"
        }
      },
      "surface-1": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.0627,
            0.0745,
            0.0941
          ],
          "hex": "#101318"
        }
      },
      "surface-2": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.0863,
            0.102,
            0.1255
          ],
          "hex": "#161a20"
        }
      },
      "surface-3": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.1137,
            0.1333,
            0.1647
          ],
          "hex": "#1d222a"
        }
      },
      "overlay": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0,
            0,
            0
          ],
          "hex": "#000000",
          "alpha": 0.6
        }
      }
    },
    "border": {
      "subtle": {
        "$value": "{color.bg.surface-3}"
      },
      "default": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.1647,
            0.1922,
            0.2314
          ],
          "hex": "#2a313b"
        }
      },
      "strong": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.2314,
            0.2667,
            0.3137
          ],
          "hex": "#3b4450"
        }
      }
    },
    "text": {
      "primary": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.8941,
            0.9059,
            0.9216
          ],
          "hex": "#e4e7eb"
        }
      },
      "secondary": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.6275,
            0.6588,
            0.702
          ],
          "hex": "#a0a8b3"
        }
      },
      "tertiary": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.4235,
            0.4588,
            0.5059
          ],
          "hex": "#6c7581"
        }
      },
      "disabled": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.2745,
            0.302,
            0.3412
          ],
          "hex": "#464d57"
        }
      },
      "inverse": {
        "$value": "{color.bg.base}"
      }
    },
    "focus": {
      "ring": {
        "$value": "{color.state.accent}"
      }
    },
    "state": {
      "positive": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.2353,
            0.6941,
            0.4745
          ],
          "hex": "#3cb179"
        }
      },
      "negative": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.898,
            0.3255,
            0.2941
          ],
          "hex": "#e5534b"
        }
      },
      "neutral": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.5412,
            0.5765,
            0.6196
          ],
          "hex": "#8a939e"
        }
      },
      "accent": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.302,
            0.6078,
            0.9412
          ],
          "hex": "#4d9bf0"
        }
      },
      "warning": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.8784,
            0.6392,
            0.2275
          ],
          "hex": "#e0a33a"
        }
      }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": {
        "$value": [
          "system-ui",
          "-apple-system",
          "Segoe UI",
          "Roboto",
          "Helvetica Neue",
          "Arial",
          "sans-serif"
        ]
      },
      "mono": {
        "$value": [
          "ui-monospace",
          "SFMono-Regular",
          "Menlo",
          "Consolas",
          "Liberation Mono",
          "monospace"
        ]
      }
    },
    "size": {
      "$type": "dimension",
      "2xs": {
        "$value": {
          "value": 10,
          "unit": "px"
        }
      },
      "xs": {
        "$value": {
          "value": 11,
          "unit": "px"
        }
      },
      "sm": {
        "$value": {
          "value": 12,
          "unit": "px"
        }
      },
      "md": {
        "$value": {
          "value": 13,
          "unit": "px"
        }
      },
      "lg": {
        "$value": {
          "value": 14,
          "unit": "px"
        }
      },
      "xl": {
        "$value": {
          "value": 16,
          "unit": "px"
        }
      },
      "2xl": {
        "$value": {
          "value": 20,
          "unit": "px"
        }
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": {
        "$value": 400
      },
      "medium": {
        "$value": 500
      },
      "semibold": {
        "$value": 600
      },
      "bold": {
        "$value": 700
      }
    },
    "line-height": {
      "$type": "number",
      "tight": {
        "$value": 1.2
      },
      "normal": {
        "$value": 1.4
      },
      "relaxed": {
        "$value": 1.6
      }
    },
    "letter-spacing": {
      "$type": "dimension",
      "tight": {
        "$value": {
          "value": -0.2,
          "unit": "px"
        }
      },
      "normal": {
        "$value": {
          "value": 0,
          "unit": "px"
        }
      },
      "wide": {
        "$value": {
          "value": 0.4,
          "unit": "px"
        }
      }
    },
    "numeric": {
      "$value": "tabular-nums",
      "$description": "font-variant-numeric for numbers and timestamps. DTCG has no type for this value.",
      "$extensions": {
        "strata": {
          "cssProperty": "font-variant-numeric"
        }
      }
    }
  },
  "space": {
    "0": {
      "$value": {
        "value": 0,
        "unit": "px"
      }
    },
    "1": {
      "$value": {
        "value": 2,
        "unit": "px"
      }
    },
    "2": {
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "3": {
      "$value": {
        "value": 6,
        "unit": "px"
      }
    },
    "4": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "5": {
      "$value": {
        "value": 10,
        "unit": "px"
      }
    },
    "6": {
      "$value": {
        "value": 12,
        "unit": "px"
      }
    },
    "8": {
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "10": {
      "$value": {
        "value": 20,
        "unit": "px"
      }
    },
    "12": {
      "$value": {
        "value": 24,
        "unit": "px"
      }
    },
    "16": {
      "$value": {
        "value": 32,
        "unit": "px"
      }
    },
    "$type": "dimension"
  },
  "radius": {
    "$type": "dimension",
    "none": {
      "$value": {
        "value": 0,
        "unit": "px"
      }
    },
    "sm": {
      "$value": {
        "value": 2,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 3,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "full": {
      "$value": {
        "value": 9999,
        "unit": "px"
      }
    }
  },
  "shadow": {
    "$type": "shadow",
    "sm": {
      "$value": {
        "color": {
          "colorSpace": "srgb",
          "components": [
            0,
            0,
            0
          ],
          "hex": "#000000",
          "alpha": 0.4
        },
        "offsetX": {
          "value": 0,
          "unit": "px"
        },
        "offsetY": {
          "value": 1,
          "unit": "px"
        },
        "blur": {
          "value": 2,
          "unit": "px"
        },
        "spread": {
          "value": 0,
          "unit": "px"
        }
      }
    },
    "md": {
      "$value": {
        "color": {
          "colorSpace": "srgb",
          "components": [
            0,
            0,
            0
          ],
          "hex": "#000000",
          "alpha": 0.5
        },
        "offsetX": {
          "value": 0,
          "unit": "px"
        },
        "offsetY": {
          "value": 4,
          "unit": "px"
        },
        "blur": {
          "value": 12,
          "unit": "px"
        },
        "spread": {
          "value": 0,
          "unit": "px"
        }
      }
    },
    "lg": {
      "$value": {
        "color": {
          "colorSpace": "srgb",
          "components": [
            0,
